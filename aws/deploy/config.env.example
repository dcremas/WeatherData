# Deployment configuration for the GHCNh pipeline.
#
# Copy to config.env and fill in with your own values. config.env is gitignored:
# this repository is public, and the real file names an AWS account, an EC2 host
# reachable on the internet, and the network it sits in. None of that is a
# credential, but together it is a map of the infrastructure, and the EC2
# security group permits SSH from 0.0.0.0/0.
#
#   cp config.env.example config.env && $EDITOR config.env
#
# Every deploy script sources this and will refuse to run without it.

# --- AWS ---------------------------------------------------------------------
AWS_REGION=us-east-2
AWS_ACCOUNT_ID=123456789012

# S3 bucket for the combined parquet, the station roster and the layer archive.
# Bucket names are globally unique, so this must be one you own.
GHCNH_BUCKET=your-ghcnh-bucket

# --- The warehouse host ------------------------------------------------------
# The EC2 instance running Postgres. EC2_HOST is used over SSH from your machine
# to create the database role; PG_HOST is the address the in-VPC Lambda uses, so
# it is the instance's PRIVATE address.
EC2_HOST=203.0.113.10
PG_HOST=172.31.0.10
SSH_KEY=/path/to/your-key.pem

PG_DB=weatherdata
PG_ROLE=ghcnh_etl
PG_PASSWORD_PARAM=/weatherdata/ghcnh_etl/password
PG_SECRET_KEY=secrets/ghcnh_etl_password

# --- Network -----------------------------------------------------------------
# The VPC the warehouse sits in. The loader Lambda is attached to these subnets;
# the download Lambda is deliberately not attached to any (see aws/README.md).
VPC_ID=vpc-xxxxxxxxxxxxxxxxx
VPC_CIDR=172.31.0.0/16
SUBNET_IDS=subnet-aaaaaaaaaaaaaaaaa,subnet-bbbbbbbbbbbbbbbbb,subnet-ccccccccccccccccc

# Security group already attached to the EC2 instance. The bootstrap script adds
# an ingress rule to it, so this must be the group Postgres is reached through.
EC2_PG_SG=sg-xxxxxxxxxxxxxxxxx

# Managed prefix list for S3 in AWS_REGION - `aws ec2 describe-prefix-lists`.
S3_PREFIX_LIST=pl-xxxxxxxx

# --- Alerting ----------------------------------------------------------------
# Address CloudWatch alarms are mailed to. "none" creates the topic and alarms
# without a subscriber. An email subscription must be confirmed from the message
# SNS sends, or alarms deliver nowhere.
ALERT_EMAIL=none

# --- Local -------------------------------------------------------------------
# Where this repository is checked out. 01_build_layer.sh copies shared_funcs.py
# from here into the Lambda layer, and 02 copies the SQL into the loader package,
# so the deployed pipeline runs the same code as the command line.
REPO=/path/to/WeatherData
